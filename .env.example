# --- Zep Cloud (https://app.getzep.com) -------------------------------------
ZEP_API_KEY=
# Grafo avulso com o conhecimento compartilhado da Umbler. Nunca dado de cliente aqui.
ZEP_ORG_GRAPH_ID=umbler_conhecimento
# Restringe a extracao aos tipos da ontologia (veja README > Ontologia).
ZEP_STRICT_ONTOLOGY=false

# --- Autenticacao -------------------------------------------------------------
# O Talk nao assina o webhook. Cadastre a URL com ?token=<valor> (ou envie o
# header X-Webhook-Token) e coloque o mesmo valor aqui.
WEBHOOK_TOKEN=troque-este-valor
# Chave que o agente/copiloto envia em X-API-Key para /contacts, /search,
# /knowledge, /admin, /health e /ontology. Gere com: openssl rand -hex 32
API_KEY=troque-este-valor
# Conversas de grupo raramente sao atendimento comercial; por padrao ficam fora.
INGEST_GROUP_CHATS=false
# Notas internas (IsPrivate=true) entram como texto no grafo do contato.
INGEST_PRIVATE_NOTES=true

# --- Persistencia: MongoDB em todos os ambientes (dev, testes e producao) ------
# URI completa (mongodb:// ou mongodb+srv://). Pode trazer usuario:senha embutidos
# ou, se preferir, deixar a URI sem credenciais e preencher os dois campos abaixo.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=talk_zep
# Os testes usam a mesma URI, num banco descartavel talk_zep_test_<hex>.
# Para apontar os testes para outra instancia: MONGODB_TEST_URI=

# --- Fila -----------------------------------------------------------------------
WORKERS=4
MAX_ATTEMPTS=5

# --- Talk API, SOMENTE LEITURA (opcional) -----------------------------------
# Usada apenas pelos scripts de backfill e para resolver nome de atendentes.
# A aplicacao nunca escreve no Talk.
TALK_API_BASE=https://app-utalk.umbler.com/api
TALK_API_TOKEN=
TALK_ORGANIZATION_ID=
# Mapa opcional {"<memberId>": "Nome do atendente"} quando nao ha token da API.
MEMBERS_FILE=members.json

LOG_LEVEL=INFO
